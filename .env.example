# Copy to .env.local and fill in. Never commit real secrets.

# --- Supabase (required) ---
# Project URL and anon key from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- LLM providers ---
# Groq powers the Llama models in the Agent node (required for the default models).
GROQ_API_KEY=your-groq-key

# OpenAI powers gpt-4o-mini agents AND embedding-based RAG retrieval.
# If unset, the RAG node automatically falls back to lexical (keyword) ranking.
OPENAI_API_KEY=your-openai-key
